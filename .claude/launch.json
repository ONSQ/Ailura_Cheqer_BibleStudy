{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cheqer-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "cwd": "app",
      "port": 8081
    },
    {
      "name": "cheqer-site",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "serve",
        "site",
        "-l",
        "8090",
        "--no-clipboard"
      ],
      "port": 8090
    }
  ]
}