{
  "expo": {
    "name": "Cheqer",
    "slug": "cheqer",
    "owner": "onsq27",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cheqer",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "net.onsq.cheqer",
      "supportsTablet": true,
      "requireFullScreen": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "net.onsq.cheqer",
      "adaptiveIcon": {
        "backgroundColor": "#1E2A3A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E2A3A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 288
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "supabaseUrl": "https://sprykzqdpybiyqzbiybr.supabase.co",
      "supabaseAnonKey": "sb_publishable_mPC9RUurQIxHzR6ESYwgPw_TRAhzBIs",
      "router": {},
      "eas": {
        "projectId": "82f30466-4bf5-4067-ab1f-4953e0a4c023"
      }
    }
  }
}
